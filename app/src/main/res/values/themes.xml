<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Xamanta" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/orange</item>
        <item name="colorPrimaryVariant">@color/orange</item>
        <item name="colorOnPrimary">@color/dark</item>
        <item name="colorSecondary">@color/black</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <style name="Theme.SetupWizard" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/suw_accent</item>
        <item name="colorPrimaryVariant">@color/suw_accent</item>
        <item name="colorOnPrimary">@color/suw_background</item>
        <item name="colorSecondary">@color/suw_accent</item>
        <item name="android:windowBackground">@color/suw_background</item>
        <item name="android:statusBarColor">@color/suw_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:navigationBarColor">@color/suw_background</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>
</resources>
